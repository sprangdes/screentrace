#!/usr/bin/env bash
set -euo pipefail

required_java=17
required_maven=3.9
required_node=18

version_at_least() {
  local actual="$1" required="$2" actual_part required_part index
  local IFS='.'
  local -a actual_parts required_parts
  IFS='.' read -r -a actual_parts <<< "$actual"
  IFS='.' read -r -a required_parts <<< "$required"
  for index in 0 1 2; do
    actual_part="${actual_parts[index]:-0}"
    required_part="${required_parts[index]:-0}"
    ((10#$actual_part > 10#$required_part)) && return 0
    ((10#$actual_part < 10#$required_part)) && return 1
  done
  return 0
}

java_major_version() {
  local version
  version="$(java -version 2>&1 | sed -n '1s/.*version "\([^"]*\)".*/\1/p')"
  version="${version#1.}"
  printf '%s\n' "${version%%[^0-9]*}"
}

maven_version() {
  mvn -version 2>/dev/null | awk 'NR == 1 { print $3 }'
}

node_major_version() {
  node --version 2>/dev/null | sed 's/^v//' | cut -d. -f1
}

needs_java() {
  command -v java >/dev/null 2>&1 && version_at_least "$(java_major_version)" "$required_java"
}

needs_maven() {
  command -v mvn >/dev/null 2>&1 && version_at_least "$(maven_version)" "$required_maven"
}

needs_node() {
  command -v node >/dev/null 2>&1 && version_at_least "$(node_major_version)" "$required_node"
}

ensure_runtime() {
  local formulae=()
  needs_java || formulae+=(openjdk@17)
  needs_maven || formulae+=(maven)
  needs_node || formulae+=(node@18)
  ((${#formulae[@]} == 0)) && return

  if ! command -v brew >/dev/null 2>&1; then
    echo "Install Homebrew from https://brew.sh, then run ./bin/screentrace setup." >&2
    exit 1
  fi
  echo "Installing ScreenTrace runtime: ${formulae[*]}"
  brew install "${formulae[@]}"
  export PATH="$(brew --prefix openjdk@17)/bin:$(brew --prefix node@18)/bin:$PATH"

  if ! needs_java || ! needs_maven || ! needs_node; then
    echo "Unable to prepare Java ${required_java}+, Maven ${required_maven}+, and Node.js ${required_node}+ automatically." >&2
    exit 1
  fi
}

base_dir="$(cd "$(dirname "$0")/.." && pwd)"

ensure_browser_renderer() {
  local renderer_dir="$base_dir/screentrace-capture"
  if [[ ! -x "$renderer_dir/node_modules/.bin/playwright" ]]; then
    echo "Installing ScreenTrace browser renderer..."
    (cd "$renderer_dir" && npm ci --no-fund)
  fi
  if ! (cd "$renderer_dir" && npx playwright install --list 2>/dev/null | grep -q chromium); then
    echo "Installing Chromium for JSP previews..."
    (cd "$renderer_dir" && npx playwright install chromium)
  fi
}

if [[ "${1:-}" == setup ]]; then
  shift
  ensure_runtime
  ensure_browser_renderer
  echo "ScreenTrace setup complete."
  exit 0
fi
if [[ "${1:-}" == doctor ]]; then
  missing=0
  needs_java || { echo "Missing Java ${required_java}+"; missing=1; }
  needs_maven || { echo "Missing Maven ${required_maven}+"; missing=1; }
  needs_node || { echo "Missing Node.js ${required_node}+"; missing=1; }
  [[ -x "$base_dir/screentrace-capture/node_modules/.bin/playwright" ]] || { echo "Missing renderer; run ./bin/screentrace setup"; missing=1; }
  ((missing == 0)) && echo "ScreenTrace dependencies are ready."
  exit "$missing"
fi
if ! needs_java || ! needs_maven || ! needs_node; then
  echo "ScreenTrace needs Java ${required_java}+, Maven ${required_maven}+, and Node.js ${required_node}+. Run ./bin/screentrace doctor, then ./bin/screentrace setup." >&2
  exit 1
fi
if [[ ! -x "$base_dir/screentrace-capture/node_modules/.bin/playwright" ]]; then
  echo "Browser renderer is missing. Run ./bin/screentrace setup." >&2
  exit 1
fi
jar="$base_dir/screentrace-cli/target/screentrace-cli-0.1.0-SNAPSHOT.jar"
needs_build=false
if [[ ! -f "$jar" ]]; then
  needs_build=true
elif find "$base_dir" -path '*/target' -prune -o -path '*/node_modules' -prune -o \( -name '*.java' -o -name 'pom.xml' \) -newer "$jar" -print -quit | grep -q .; then
  needs_build=true
fi
if [[ "$needs_build" == true ]]; then
  echo "Building updated ScreenTrace..."
  (cd "$base_dir" && mvn -q -DskipTests package)
fi
exec java -jar "$jar" "$@"
