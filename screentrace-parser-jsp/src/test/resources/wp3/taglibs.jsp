<html:form action="/save"><html:text property="text"/><html:password property="password"/><html:textarea property="notes"/><html:select property="select"><html:options collection="values"/><html:optionsCollection name="values"/></html:select><html:checkbox property="check"/><html:multibox property="many"/><html:radio property="radio"/><html:file property="file"/><html:hidden property="hidden"/><html:submit/><html:button/><html:cancel/><html:reset/><html:link action="/save"/></html:form>
<form:form modelAttribute="model"><form:input path="text"/><form:password path="password"/><form:textarea path="notes"/><form:select path="select"><form:options items="${values}"/></form:select><form:select path="many" multiple="multiple"/><form:checkbox path="check"/><form:checkboxes path="checks"/><form:radiobutton path="radio"/><form:radiobuttons path="radios"/><form:hidden path="hidden"/><form:button type="submit"/></form:form>
<c:forEach items="${items}" var="item"><input type="number" name="count" min="0" max="10" /><input type="url" name="url" /></c:forEach>
<div class="modal" id="one"></div><div role="dialog" id="two"></div><dialog id="three"></dialog><button data-toggle="modal" data-target="#one" type="button"/><button data-bs-toggle="modal" data-bs-target="#two" type="button"/>
<custom:selector onchange="select()" /><bean:write name="model" property="text"/>
