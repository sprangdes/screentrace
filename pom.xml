<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.screentrace</groupId>
  <artifactId>screentrace</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <jackson.version>2.21.7</jackson.version>
    <javaparser.version>3.26.1</javaparser.version>
    <jline.version>3.30.14</jline.version>
    <dependency-check.nvd-datafeed-url>https://nvd.nist.gov/feeds/json/cve/2.0/nvdcve-2.0-{0}.json.gz</dependency-check.nvd-datafeed-url>
  </properties>

  <modules>
    <module>screentrace-core</module>
    <module>screentrace-scanner</module>
    <module>screentrace-parser-jsp</module>
    <module>screentrace-adapter-spring</module>
    <module>screentrace-adapter-struts</module>
    <module>screentrace-report</module>
    <module>screentrace-cli</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.javaparser</groupId>
        <artifactId>javaparser-core</artifactId>
        <version>${javaparser.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.jline</groupId>
        <artifactId>jline</artifactId>
        <version>${jline.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>12.2.2</version>
          <configuration>
            <failBuildOnCVSS>7</failBuildOnCVSS>
            <failOnError>true</failOnError>
            <nvdDatafeedUrl>${dependency-check.nvd-datafeed-url}</nvdDatafeedUrl>
            <!-- The NVD feed server can stall mid-download; wait longer than the 60 second default before giving up. -->
            <readTimeout>180000</readTimeout>
            <formats>
              <format>HTML</format>
              <format>JSON</format>
            </formats>
          </configuration>
        </plugin>
        <!-- Source formatting (HC-001). Not bound to any lifecycle phase, so `mvn verify` never downloads it;
             CI runs `mvn com.diffplug.spotless:spotless-maven-plugin:check`, and
             `mvn com.diffplug.spotless:spotless-maven-plugin:apply` reformats. Fixtures and test resources are excluded. -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>2.43.0</version>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>
              <googleJavaFormat>
                <version>1.24.0</version>
              </googleJavaFormat>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Test coverage report (HC-003). Only `-Pcoverage` attaches the JaCoCo agent, so the launchers'
         builds and a plain `mvn verify` are unchanged; each module writes target/site/jacoco/. No threshold. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.15</version>
            <executions>
              <execution>
                <id>coverage-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>coverage-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
